# `npm run desk:setup` creates .env.desk with the first two. Add them to Vercel, Production only.
DESK_ENCRYPTION_KEY=
DESK_FIREBASE_KEY_B64=

# One per connected app, from that app's own Firebase project. Production only.
APP_DRIVSYNC_FIREBASE_KEY_B64=

# Security emails (optional: without them, nothing is sent and nothing else changes).
BREVO_API_KEY=
DESK_ALERT_SENDER=
